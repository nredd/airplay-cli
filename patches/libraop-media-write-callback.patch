diff --git a/src/raop_client.h b/src/raop_client.h
index 4be0ff8..4bdffd0 100644
--- a/src/raop_client.h
+++ b/src/raop_client.h
@@ -84,6 +84,66 @@ typedef struct raopcl_t {uint32_t dummy;} raopcl_t;
 
 struct raopcl_s;
 
+/* Caller path, not proof of stimulus content. */
+typedef enum {
+	RAOP_MEDIA_FRESH = 0,
+	RAOP_MEDIA_BACKLOG
+} raop_media_origin_t;
+
+/* Synchronous, success-only audio notification under the client mutex.
+ * destination is the actual sendto address, borrowed ONLY until callback returns.
+ * Copy bounded data only: no I/O, blocking, reentry into libraop, or retained
+ * pointers. Includes the RTP header in datagram_bytes; excludes sync and RTX.
+ * This is kernel write acceptance, NOT egress, delivery or playback evidence,
+ * and NOT complete failure/drop accounting. No notification on non-ready or
+ * failed select, even if the legacy path subsequently attempts a send.
+ */
+typedef void (*raop_media_write_cb)(void *ctx, raop_media_origin_t origin,
+								  size_t datagram_bytes, const struct sockaddr_in *destination);
+
+/* Default NULL. Install before starting media. Serialized with both media
+ * callers; replacing/clearing waits for any active callback to finish. Keep the
+ * old ctx alive until this returns. NULL callback clears ctx as well. Do not call
+ * from a callback. Before destruction, clear the callback, stop/join ALL client
+ * API callers, then destroy; destruction itself requires exclusive ownership.
+ * A concurrent setter must also be joined before destroying the client.
+ */
+void raopcl_set_media_write_cb(struct raopcl_s *p, raop_media_write_cb callback, void *ctx);
+
+/* Separate optional synchronous OUTCOME hook, default NULL, same locking and
+ * lifetime rules as raop_media_write_cb (set/clear only outside callbacks and
+ * under the caller's external send ownership; never from a callback). Exactly
+ * one outcome is reported for every audio attempt of both callers (fresh and
+ * backlog), with the caller origin. destination is non-NULL only for SENT: the
+ * actual sendto address of one full datagram that select reported ready.
+ * SELECT_ERROR is reported even when the legacy path still sent successfully,
+ * so that write is never a qualifying observation. setup_port is the SETUP
+ * server_port parsed separately and strictly (0 when absent or invalid), NOT
+ * derived from the send address. Sync, control and RTX are never reported.
+ * Legacy send behavior and return values are unchanged. Kernel write acceptance
+ * only, not egress, delivery or playback evidence. */
+typedef enum {
+	RAOP_MEDIA_OUTCOME_SENT = 0,
+	RAOP_MEDIA_OUTCOME_NOT_READY,
+	RAOP_MEDIA_OUTCOME_SELECT_ERROR,
+	RAOP_MEDIA_OUTCOME_SEND_ERROR,
+	RAOP_MEDIA_OUTCOME_UNAVAILABLE
+} raop_media_outcome_t;
+
+typedef void (*raop_media_outcome_cb)(void *ctx, raop_media_outcome_t outcome,
+									raop_media_origin_t origin, size_t datagram_bytes,
+									const struct sockaddr_in *destination,
+									uint16_t setup_port);
+
+void raopcl_set_media_outcome_cb(struct raopcl_s *p, raop_media_outcome_cb callback, void *ctx);
+
+/* Nonzero count bumped by every media hook set (write or outcome), even an
+ * identical one, so an owner can detect a registration change. 0 for NULL. */
+uint32_t raopcl_media_registration_generation(struct raopcl_s *p);
+
+/* The separately parsed SETUP server_port, 0 when unknown. */
+uint16_t raopcl_media_setup_port(struct raopcl_s *p);
+
 typedef enum raop_codec_s { RAOP_PCM = 0, RAOP_ALAC_RAW, RAOP_ALAC, RAOP_AAC,
 							RAOP_AAL_ELC } raop_codec_t;
 typedef enum raop_crypto_s { RAOP_CLEAR = 0, RAOP_RSA, RAOP_FAIRPLAY, RAOP_MFISAP,

# ThreadSanitizer suppressions for the REAL-binary test only (see Makefile
# test-cli-real-receipt). Each entry is a race between libraop's own RTP
# timing/control threads and its connect/disconnect/sync code, on lines this
# repo does not change (they are upstream context, never `+` lines, in
# patches/). They are not the receipt collector. Nothing in src/media_receipt.c,
# src/cliairplay.c, or any line the patches add is suppressed; any other race
# in the child still fails the test.
race:raopcl_analyse_setup
race:_raopcl_disconnect
race:_raopcl_send_sync
race:_raopcl_terminate_rtp
